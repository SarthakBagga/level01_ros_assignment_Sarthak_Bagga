Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
    Expanded: ~
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Value: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Use Timestamp: false
      Topic:
        Value: /map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Value: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
      TF Prefix: ""
      Update Interval: 0
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Value: true
      Alpha: 1
      Color Transformer: FlatColor
      Color: 235; 40; 40
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 2
      Size (m): 0.02
      Decay Time: 0
      Use Fixed Frame: true
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Frame Timeout: 15
      Marker Scale: 0.25
      Show Axes: true
      Show Arrows: false
      Show Names: false
      Update Interval: 0
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        base_footprint:
          Value: true
        base_link:
          Value: true
        lidar_link_1:
          Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL Particles
      Enabled: true
      Value: true
      Alpha: 0.65
      Color: 25; 155; 65
      Shape: Arrow (Flat)
      Min Arrow Length: 0.02
      Max Arrow Length: 0.15
      Topic:
        Value: /particle_cloud
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Value: true
      Alpha: 1
      Color: 25; 115; 225
      Line Style: Billboards
      Line Width: 0.04
      Buffer Length: 1
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0.03
      Topic:
        Value: /plan
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Value: true
      Alpha: 0.22
      Color Scheme: costmap
      Draw Behind: false
      Use Timestamp: false
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Update Topic:
        Value: /global_costmap/costmap_updates
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Value: true
      Alpha: 0.40
      Color Scheme: costmap
      Draw Behind: false
      Use Timestamp: false
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Update Topic:
        Value: /local_costmap/costmap_updates
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Enabled: true
  Global Options:
    Background Color: 44; 48; 56
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Value: /initialpose
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Playground overview
      Angle: 0
      Scale: 28
      Target Frame: map
      X: 0
      Y: 0
      Near Clip Distance: 0.01
      Invert Z Axis: false
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Playground overview
        Angle: 0
        Scale: 28
        Target Frame: map
        X: 0
        Y: 0
        Near Clip Distance: 0.01
        Invert Z Axis: false
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Robot detail
        Angle: 0
        Scale: 100
        Target Frame: base_footprint
        X: 0
        Y: 0
        Near Clip Distance: 0.01
        Invert Z Axis: false
Window Geometry:
  Width: 1280
  Height: 900
  X: 66
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: false
